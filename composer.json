{
    "name": "texthtml/vo-identity",
    "description": "Make comparing Value Objects easier & safer",
    "type": "library",
    "license": "MIT",
    "keywords": ["value-object", "vo", "identity-map", "equality", "immutable"],
    "autoload": {
        "psr-4": {
            "TH\\VOIdentity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TH\\VOIdentity\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Mathieu Rochette",
            "email": "mathieu@texthtml.net"
        }
    ],
    "require": {
        "php": "^8.2",
        "texthtml/object-reaper": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3||^12.0||^13.0",
        "texthtml/doctest": "^0.3.0",
        "carthage-software/mago": "^1.59"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "mago lint",
        "analyze": "mago analyze",
        "fmt": "mago fmt",
        "test": [
            "@composer validate --strict",
            "mago fmt --check",
            "@lint",
            "@analyze",
            "phpunit",
            "doctest src/ examples/"
        ]
    }
}
